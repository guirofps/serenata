como-fazer-uma-musica-para-alguem-og.jpg\\"],\\"datePublished\\":\\"2026-10-03\\",\\"dateModified\\":\\"2026-10-03\\",\\"inLanguage\\":\\"pt-BR\\",\\"author\\":{\\"@type\\":\\"Organization\\",\\"@id\\":\\"https://www.serenatagift.com/#organizacao\\",\\"name\\":\\"Serenata\\",\\"url\\":\\"https://www.serenatagift.com/\\",\\"logo\\":{\\"@type\\":\\"ImageObject\\",\\"url\\":\\"https://www.serenatagift.com/img/logo-serenata.png\\"}},\\"publisher\\":{\\"@type\\":\\"Organization\\",\\"@id\\":\\"https://www.serenatagift.com/#organizacao\\",\\"name\\":\\"Serenata\\",\\"url\\":\\"https://www.serenatagift.com/\\",\\"logo\\":{\\"@type\\":\\"ImageObject\\",\\"url\\":\\"https://www.serenatagift.com/img/logo-serenata.png\\"}},\\"mainEntityOfPage\\":\\"https://www.serenatagift.com/blog/como-fazer-uma-musica-para-alguem\\"},{\\"@type\\":\\"BreadcrumbList\\",\\"itemListElement\\":[{\\"@type\\":\\"ListItem\\",\\"position\\":1,\\"name\\":\\"Início\\",\\"item\\":\\"https://www.serenatagift.com/\\"},{\\"@type\\":\\"ListItem\\",\\"position\\":2,\\"name\\":\\"Blog\\",\\"item\\":\\"https://www.serenatagift.com/blog\\"},{\\"@type\\":\\"ListItem\\",\\"position\\":3,\\"name\\":\\"Como fazer uma música para alguém (mesmo sem saber compor)\\",\\"item\\":\\"https://www.serenatagift.com/blog/como-fazer-uma-musica-para-alguem\\"}]},{\\"@type\\":\\"FAQPage\\",\\"mainEntity\\":[{\\"@type\\":\\"Question\\",\\"name\\":\\"Preciso saber cantar ou tocar?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Não. Você só conta a história. A letra é escrita a partir dela, e a música é composta e cantada no estilo que você escolher.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"Posso contar a história por áudio?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Pode. Em vez de digitar, você grava um áudio contando, do jeito que falaria pra um amigo. A história falada costuma sair mais solta e cheia de detalhe.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"E se a letra não ficar boa?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Você lê a letra inteira antes de pagar qualquer coisa. Se não gostar, pede pra reescrever de graça. E se ainda assim não for a cara da pessoa, é só não seguir.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"A música é original?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"É. Ela é composta e gravada do zero a partir da história que você contou. Não é catálogo nem modelo pronto com o nome trocado.\\"}}]}]}"}]}"`;

exports[`a Serenata sai igual depois do motor > artigo hino-personalizado 1`] = `"{"meta":[{"title":"Hino personalizado: o som dos hinos da igreja | Serenata"},{"name":"description","content":"Hino personalizado no estilo Gospel tradicional, feito da sua história: um louvor pra Deus ou presente pra avós e pais que amam hinos. Letra na hora."},{"property":"og:type","content":"article"},{"property":"og:title","content":"Hino personalizado: o som dos hinos da igreja | Serenata"},{"property":"og:description","content":"Hino personalizado no estilo Gospel tradicional, feito da sua história: um louvor pra Deus ou presente pra avós e pais que amam hinos. Letra na hora."},{"property":"og:url","content":"https://www.serenatagift.com/blog/hino-personalizado"},{"property":"og:image","content":"https://www.serenatagift.com/img/blog/hino-personalizado-og.jpg"},{"property":"og:image:width","content":"1200"},{"property":"og:image:height","content":"630"},{"property":"og:site_name","content":"Serenata"},{"property":"og:locale","content":"pt_BR"},{"property":"article:published_time","content":"2026-10-03"},{"property":"article:modified_time","content":"2026-10-03"},{"name":"twitter:card","content":"summary_large_image"},{"name":"twitter:image","content":"https://www.serenatagift.com/img/blog/hino-personalizado-og.jpg"}],"links":[{"rel":"canonical","href":"https://www.serenatagift.com/blog/hino-personalizado"}],"scripts":[{"type":"application/ld+json","children":"{\\"@context\\":\\"https://schema.org\\",\\"@graph\\":[{\\"@type\\":\\"Article\\",\\"headline\\":\\"Hino personalizado: uma música nova com o som dos hinos da igreja\\",\\"description\\":\\"Hino personalizado no estilo Gospel tradicional, feito da sua história: um louvor pra Deus ou presente pra avós e pais que amam hinos. Letra na hora.\\",\\"image\\":[\\"https://www.serenatagift.com/img/blog/hino-personalizado.webp\\",\\"https://www.serenatagift.com/img/blog/hino-personalizado-og.jpg\\"],\\"datePublished\\":\\"2026-10-03\\",\\"dateModified\\":\\"2026-10-03\\",\\"inLanguage\\":\\"pt-BR\\",\\"author\\":{\\"@type\\":\\"Organization\\",\\"@id\\":\\"https://www.serenatagift.com/#organizacao\\",\\"name\\":\\"Serenata\\",\\"url\\":\\"https://www.serenatagift.com/\\",\\"logo\\":{\\"@type\\":\\"ImageObject\\",\\"url\\":\\"https://www.serenatagift.com/img/logo-serenata.png\\"}},\\"publisher\\":{\\"@type\\":\\"Organization\\",\\"@id\\":\\"https://www.serenatagift.com/#organizacao\\",\\"name\\":\\"Serenata\\",\\"url\\":\\"https://www.serenatagift.com/\\",\\"logo\\":{\\"@type\\":\\"ImageObject\\",\\"url\\":\\"https://www.serenatagift.com/img/logo-serenata.png\\"}},\\"mainEntityOfPage\\":\\"https://www.serenatagift.com/blog/hino-personalizado\\"},{\\"@type\\":\\"BreadcrumbList\\",\\"itemListElement\\":[{\\"@type\\":\\"ListItem\\",\\"position\\":1,\\"name\\":\\"Início\\",\\"item\\":\\"https://www.serenatagift.com/\\"},{\\"@type\\":\\"ListItem\\",\\"position\\":2,\\"name\\":\\"Blog\\",\\"item\\":\\"https://www.serenatagift.com/blog\\"},{\\"@type\\":\\"ListItem\\",\\"position\\":3,\\"name\\":\\"Hino personalizado: uma música nova com o som dos hinos da igreja\\",\\"item\\":\\"https://www.serenatagift.com/blog/hino-personalizado\\"}]},{\\"@type\\":\\"FAQPage\\",\\"mainEntity\\":[{\\"@type\\":\\"Question\\",\\"name\\":\\"O hino personalizado é um hino antigo com o nome trocado?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Não. É uma música nova, composta e gravada do zero a partir da história que você contou, no estilo Gospel tradicional. Ninguém mais recebe a mesma música.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"Posso fazer um hino como presente pra minha avó?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Pode. Escolha o presente pra alguém, com fé, e o estilo Gospel tradicional. A música fala da sua avó, e a fé aparece como gratidão e bênção na vida dela.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"Meus pais não usam muito o celular. Como eles vão ouvir?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Você recebe a página com a música e também o MP3. Dá pra tocar numa caixinha de som, no carro ou imprimir o QR Code num cartão pra alguém da família ajudar a abrir.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"Dá pra mudar alguma coisa depois?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Antes de pagar, você lê a letra inteira e pode pedir pra reescrever de graça. Depois de comprar, ainda dá pra pedir ajuste num trecho da letra, no estilo ou na voz.\\"}}]}]}"}]}"`;

