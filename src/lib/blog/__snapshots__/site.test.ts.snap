,\\"datePublished\\":\\"2026-10-03\\",\\"dateModified\\":\\"2026-10-03\\",\\"inLanguage\\":\\"pt-BR\\",\\"author\\":{\\"@type\\":\\"Organization\\",\\"@id\\":\\"https://www.serenatagift.com/#organizacao\\",\\"name\\":\\"Serenata\\",\\"url\\":\\"https://www.serenatagift.com/\\",\\"logo\\":{\\"@type\\":\\"ImageObject\\",\\"url\\":\\"https://www.serenatagift.com/img/logo-serenata.png\\"}},\\"publisher\\":{\\"@type\\":\\"Organization\\",\\"@id\\":\\"https://www.serenatagift.com/#organizacao\\",\\"name\\":\\"Serenata\\",\\"url\\":\\"https://www.serenatagift.com/\\",\\"logo\\":{\\"@type\\":\\"ImageObject\\",\\"url\\":\\"https://www.serenatagift.com/img/logo-serenata.png\\"}},\\"mainEntityOfPage\\":\\"https://www.serenatagift.com/blog/musica-personalizada-para-pai\\"},{\\"@type\\":\\"BreadcrumbList\\",\\"itemListElement\\":[{\\"@type\\":\\"ListItem\\",\\"position\\":1,\\"name\\":\\"Início\\",\\"item\\":\\"https://www.serenatagift.com/\\"},{\\"@type\\":\\"ListItem\\",\\"position\\":2,\\"name\\":\\"Blog\\",\\"item\\":\\"https://www.serenatagift.com/blog\\"},{\\"@type\\":\\"ListItem\\",\\"position\\":3,\\"name\\":\\"Música personalizada para pai: um presente feito da história dele\\",\\"item\\":\\"https://www.serenatagift.com/blog/musica-personalizada-para-pai\\"}]},{\\"@type\\":\\"FAQPage\\",\\"mainEntity\\":[{\\"@type\\":\\"Question\\",\\"name\\":\\"E se meu pai não for de demonstrar emoção?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Melhor ainda. A música diz o que ele nunca ouviu em voz alta, e ele não precisa responder nada. Muito pai que não chora em público ouve a música sozinho, de novo e de novo.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"Posso fazer em nome dos irmãos?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Pode. Conte a história com as lembranças de todos e diga na história que a homenagem é dos filhos. A letra é escrita a partir do que você contar, e você lê inteira antes de decidir.\\"}},{\\"@type\\":\\"Question\\