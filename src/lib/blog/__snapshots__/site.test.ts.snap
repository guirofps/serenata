log/presente-para-amiga-evangelica-og.jpg\\"],\\"datePublished\\":\\"2026-10-03\\",\\"dateModified\\":\\"2026-10-03\\",\\"inLanguage\\":\\"pt-BR\\",\\"author\\":{\\"@type\\":\\"Organization\\",\\"@id\\":\\"https://www.serenatagift.com/#organizacao\\",\\"name\\":\\"Serenata\\",\\"url\\":\\"https://www.serenatagift.com/\\",\\"logo\\":{\\"@type\\":\\"ImageObject\\",\\"url\\":\\"https://www.serenatagift.com/img/logo-serenata.png\\"}},\\"publisher\\":{\\"@type\\":\\"Organization\\",\\"@id\\":\\"https://www.serenatagift.com/#organizacao\\",\\"name\\":\\"Serenata\\",\\"url\\":\\"https://www.serenatagift.com/\\",\\"logo\\":{\\"@type\\":\\"ImageObject\\",\\"url\\":\\"https://www.serenatagift.com/img/logo-serenata.png\\"}},\\"mainEntityOfPage\\":\\"https://www.serenatagift.com/blog/presente-para-amiga-evangelica\\"},{\\"@type\\":\\"BreadcrumbList\\",\\"itemListElement\\":[{\\"@type\\":\\"ListItem\\",\\"position\\":1,\\"name\\":\\"Início\\",\\"item\\":\\"https://www.serenatagift.com/\\"},{\\"@type\\":\\"ListItem\\",\\"position\\":2,\\"name\\":\\"Blog\\",\\"item\\":\\"https://www.serenatagift.com/blog\\"},{\\"@type\\":\\"ListItem\\",\\"position\\":3,\\"name\\":\\"Presente para amiga evangélica: uma música com a história de vocês duas\\",\\"item\\":\\"https://www.serenatagift.com/blog/presente-para-amiga-evangelica\\"}]},{\\"@type\\":\\"FAQPage\\",\\"mainEntity\\":[{\\"@type\\":\\"Question\\",\\"name\\":\\"A música vai falar de Deus?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Vai, com cuidado. No caminho do presente com fé, a letra é sobre a sua amiga e a amizade de vocês, e a fé aparece como gratidão e bênção na vida dela, sem pregação.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"Posso gravar um áudio em vez de escrever?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Pode. Muita gente acha mais fácil contar falando, como se estivesse conversando com alguém. A letra sai do que você contou.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"Como eu entrego pra ela?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Você recebe um link de uma página com a música tocando, a letra acendendo no ritmo e o nome dela na capa. Dá pra mandar no WhatsApp ou imprimir o QR Code num cartão. Vem também o MP3.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"E se a letra não ficar do jeito que eu queria?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Antes de pagar, você lê a letra inteira e pode pedir pra reescrever de graça. Depois de comprar, ainda dá pra pedir ajuste num trecho, no estilo ou na voz.\\"}}]}]}"}]}"`;

