ft.com/img/blog/homenagem-dia-das-maes-igreja-og.jpg\\"],\\"datePublished\\":\\"2026-10-03\\",\\"dateModified\\":\\"2026-10-03\\",\\"inLanguage\\":\\"pt-BR\\",\\"author\\":{\\"@type\\":\\"Organization\\",\\"@id\\":\\"https://www.serenatagift.com/#organizacao\\",\\"name\\":\\"Serenata\\",\\"url\\":\\"https://www.serenatagift.com/\\",\\"logo\\":{\\"@type\\":\\"ImageObject\\",\\"url\\":\\"https://www.serenatagift.com/img/logo-serenata.png\\"}},\\"publisher\\":{\\"@type\\":\\"Organization\\",\\"@id\\":\\"https://www.serenatagift.com/#organizacao\\",\\"name\\":\\"Serenata\\",\\"url\\":\\"https://www.serenatagift.com/\\",\\"logo\\":{\\"@type\\":\\"ImageObject\\",\\"url\\":\\"https://www.serenatagift.com/img/logo-serenata.png\\"}},\\"mainEntityOfPage\\":\\"https://www.serenatagift.com/blog/homenagem-dia-das-maes-igreja\\"},{\\"@type\\":\\"BreadcrumbList\\",\\"itemListElement\\":[{\\"@type\\":\\"ListItem\\",\\"position\\":1,\\"name\\":\\"Início\\",\\"item\\":\\"https://www.serenatagift.com/\\"},{\\"@type\\":\\"ListItem\\",\\"position\\":2,\\"name\\":\\"Blog\\",\\"item\\":\\"https://www.serenatagift.com/blog\\"},{\\"@type\\":\\"ListItem\\",\\"position\\":3,\\"name\\":\\"Homenagem de Dia das Mães na igreja: uma música feita pras mães da congregação\\",\\"item\\":\\"https://www.serenatagift.com/blog/homenagem-dia-das-maes-igreja\\"}]},{\\"@type\\":\\"FAQPage\\",\\"mainEntity\\":[{\\"@type\\":\\"Question\\",\\"name\\":\\"Dá pra fazer uma música pra todas as mães da igreja?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Pra homenagear todas de uma vez, o caminho é o louvor pra Deus com o motivo \\\\\\"Pra minha igreja\\\\\\", agradecendo pelas mães da comunidade. O presente com fé é feito pra uma pessoa: funciona pra uma mãe que represente todas, como a mais antiga da igreja.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"Como passar a música no telão com a letra?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"A música vem numa página com a letra acendendo no ritmo. É só abrir essa página no computador ligado ao projetor e tocar.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"Dá pra entregar a música pra cada mãe levar pra casa?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Dá. Imprima o QR Code da página nos cartões que vão ser entregues às mães. Cada uma aponta a câmera e ouve no próprio celular.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"Quanto tempo leva pra ficar pronta?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"A letra fica pronta em segundos e é de graça. A música cantada fica pronta em poucos minutos, e você ouve um trecho antes de decidir.\\"}}]}]}"}]}"`;

