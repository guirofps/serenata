exports[`a Serenata sai igual depois do motor > artigo como-escrever-um-louvor 1`] = `"{"meta":[{"title":"Como escrever um louvor: guia passo a passo | Serenata"},{"name":"description","content":"Como escrever um louvor: escolher o motivo, contar com detalhe, fugir das frases feitas e montar verso e refrão. E o caminho rápido pra letra pronta."},{"property":"og:type","content":"article"},{"property":"og:title","content":"Como escrever um louvor: guia passo a passo | Serenata"},{"property":"og:description","content":"Como escrever um louvor: escolher o motivo, contar com detalhe, fugir das frases feitas e montar verso e refrão. E o caminho rápido pra letra pronta."},{"property":"og:url","content":"https://www.serenatagift.com/blog/como-escrever-um-louvor"},{"property":"og:image","content":"https://www.serenatagift.com/img/blog/como-escrever-um-louvor-og.jpg"},{"property":"og:image:width","content":"1200"},{"property":"og:image:height","content":"630"},{"property":"og:site_name","content":"Serenata"},{"property":"og:locale","content":"pt_BR"},{"property":"article:published_time","content":"2026-10-03"},{"property":"article:modified_time","content":"2026-10-03"},{"name":"twitter:card","content":"summary_large_image"},{"name":"twitter:image","content":"https://www.serenatagift.com/img/blog/como-escrever-um-louvor-og.jpg"}],"links":[{"rel":"canonical","href":"https://www.serenatagift.com/blog/como-escrever-um-louvor"}],"scripts":[{"type":"application/ld+json","children":"{\\"@context\\":\\"https://schema.org\\",\\"@graph\\":[{\\"@type\\":\\"Article\\",\\"headline\\":\\"Como escrever um louvor: guia prático do motivo ao refrão\\",\\"description\\":\\"Como escrever um louvor: escolher o motivo, contar com detalhe, fugir das frases feitas e montar verso e refrão. E o caminho rápido pra letra pronta.\\",\\"image\\":[\\"https://www.serenatagift.com/img/blog/como-escrever-um-louvor.webp\\",\\"https://www.serenatagift.com/img/blog/como-escrever-um-louvor-og.jpg\\"],\\"datePublished\\":\\"2026-10-03\\",\\"dateModified\\":\\"2026-10-03\\",\\"inLanguage\\":\\"pt-BR\\",\\"author\\":{\\"@type\\":\\"Organization\\",\\"@id\\":\\"https://www.serenatagift.com/#organizacao\\",\\"name\\":\\"Serenata\\",\\"url\\":\\"https://www.serenatagift.com/\\",\\"logo\\":{\\"@type\\":\\"ImageObject\\",\\"url\\":\\"https://www.serenatagift.com/img/logo-serenata.png\\"}},\\"publisher\\":{\\"@type\\":\\"Organization\\",\\"@id\\":\\"https://www.serenatagift.com/#organizacao\\",\\"name\\":\\"Serenata\\",\\"url\\":\\"https://www.serenatagift.com/\\",\\"logo\\":{\\"@type\\":\\"ImageObject\\",\\"url\\":\\"https://www.serenatagift.com/img/logo-serenata.png\\"}},\\"mainEntityOfPage\\":\\"https://www.serenatagift.com/blog/como-escrever-um-louvor\\"},{\\"@type\\":\\"BreadcrumbList\\",\\"itemListElement\\":[{\\"@type\\":\\"ListItem\\",\\"position\\":1,\\"name\\":\\"Início\\",\\"item\\":\\"https://www.serenatagift.com/\\"},{\\"@type\\":\\"ListItem\\",\\"position\\":2,\\"name\\":\\"Blog\\",\\"item\\":\\"https://www.serenatagift.com/blog\\"},{\\"@type\\":\\"ListItem\\",\\"position\\":3,\\"name\\":\\"Como escrever um louvor: guia prático do motivo ao refrão\\",\\"item\\":\\"https://www.serenatagift.com/blog/como-escrever-um-louvor\\"}]},{\\"@type\\":\\"FAQPage\\",\\"mainEntity\\":[{\\"@type\\":\\"Question\\",\\"name\\":\\"Preciso saber tocar algum instrumento pra escrever um louvor?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Pra escrever a letra, não. Pra transformar a letra em música, ajuda muito. Se você não toca, dá pra contar a história no caminho gospel e receber a letra e a música compostas do zero.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"O louvor precisa rimar?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Não precisa rimar em todo verso. Rima forçada atrapalha mais do que ajuda. O que não pode faltar é o detalhe concreto e um refrão fácil de lembrar.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"Quantas estrofes um louvor deve ter?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Duas ou três estrofes com um refrão que se repete entre elas já formam um louvor completo. Mais importante que o tamanho é cada parte ter uma ideia clara.\\"}},{\\"@type\\":\\"Question\\",\\"name\\":\\"Posso escrever a história e deixar a letra pronta com vocês?\\",\\"acceptedAnswer\\":{\\"@type\\":\\"Answer\\",\\"text\\":\\"Pode. No caminho gospel você conta a história, digitando ou por áudio, e a letra fica pronta em segundos e de graça. Se não gostar, pede pra reescrever, também de graça.\\"}}]}]}"}]}"`;

