{
  "installCommand": "npm install",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), payment=(self \"https://js.stripe.com\"), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(admin|recuperar)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "functions": {
    "api/inngest.ts": {
      "maxDuration": 300
    },
    "api/webhook/cakto.ts": {
      "maxDuration": 30
    },
    "api/ssr.js": {
      "maxDuration": 60
    },
    "api/quadro-pdf/[token].ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "api/vigia-pagamento.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "(www\\.)?balladgift\\.com" }],
      "destination": "/ballad/robots.txt",
      "permanent": false
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "(www\\.)?balladgift\\.com" }],
      "destination": "/ballad/sitemap.xml",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/inngest",
      "destination": "/api/inngest"
    },
    {
      "source": "/api/conversoes.csv",
      "destination": "/api/conversoes"
    },
    {
      "source": "/api/publicos.csv",
      "destination": "/api/publicos"
    },
    {
      "source": "/api/publicos/:lista([a-zA-Z]+).csv",
      "destination": "/api/publicos?lista=:lista"
    },
    {
      "source": "/api/og/:token",
      "destination": "/api/og/[token]"
    },
    {
      "source": "/api/previa/:id",
      "destination": "/api/previa/[id]"
    },
    {
      "source": "/api/quadro-pdf/:token",
      "destination": "/api/quadro-pdf/[token]"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/ssr"
    }
  ],
  "crons": [
    {
      "path": "/api/vigia-externo",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/vigia-pagamento",
      "schedule": "*/30 * * * *"
    }
  ]
}
