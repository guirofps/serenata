{
  "installCommand": "npm install",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "regions": ["gru1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), payment=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(admin|recuperar)(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ],
  "functions": {
    "api/inngest.ts": { "maxDuration": 300 },
    "api/webhook/cakto.ts": { "maxDuration": 30 },
    "api/ssr.js": { "maxDuration": 60 },
    "api/quadro-pdf/[token].ts": { "maxDuration": 60, "memory": 2048 }
  },
  "rewrites": [
    { "source": "/api/inngest", "destination": "/api/inngest" },
    { "source": "/api/conversoes.csv", "destination": "/api/conversoes" },
    { "source": "/api/og/:token", "destination": "/api/og/[token]" },
    { "source": "/api/previa/:id", "destination": "/api/previa/[id]" },
    { "source": "/api/quadro-pdf/:token", "destination": "/api/quadro-pdf/[token]" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/api/ssr" }
  ]
}
